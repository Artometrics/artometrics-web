    "margin": { "t": 60, "b": 60, "l": 40, "r": 40 },
    "height": 320,
    "plot_bgcolor": "#FFFFFF",
    "paper_bgcolor": "#FFFFFF",
    "font": { "family": "DM Sans, sans-serif", "color": "#1A1A1A" }
