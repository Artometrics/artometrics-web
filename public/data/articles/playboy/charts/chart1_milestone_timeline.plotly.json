{
  "data": [
    {
      "type": "scatter",
      "mode": "markers+text",
      "x": ["1953-01-01", "2017-01-01", "2021-01-01", "2024-01-01"],
      "y": [1, 1, 1, 1],
      "text": [
        "1953<br>Founded",
        "2017<br>Hefner dies",
        "2021<br>PLBY SPAC listing",
        "2024<br>Cooper bid rejected"
